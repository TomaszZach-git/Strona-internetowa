---
import Base from "../layouts/Base.astro";
---

<Base title="Nie znaleziono strony (404)" description="Strona, której szukasz, nie istnieje." noindex>
  <section class="container-x py-28 text-center">
    <p class="text-7xl font-extrabold text-brand-600">404</p>
    <h1 class="mt-4 text-3xl font-extrabold">Tej strony tu nie ma</h1>
    <p class="mt-3 text-muted">Mogła zostać przeniesiona albo adres zawiera literówkę.</p>
    <a href="/" class="btn-primary mt-8">Wróć na stronę główną</a>
  </section>
</Base>
