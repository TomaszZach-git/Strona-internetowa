---
import { site } from "../config/site.config";
const adresPelny = `${site.adres.ulica}, ${site.adres.kod} ${site.adres.miasto}`;
const nawiguj = `https://www.google.com/maps/dir/?api=1&destination=${site.geo.lat},${site.geo.lng}`;
const endpoint = site.formularzEndpoint;
---

<section id="kontakt" class="scroll-mt-20 py-20 md:py-28">
  <div class="container-x grid gap-12 lg:grid-cols-2">
    <div>
      <p class="eyebrow">Kontakt</p>
      <h2 class="h2 mt-2">Umów bezpłatną wizję lokalną</h2>
      <p class="mt-4 text-muted">Oddzwaniamy w ciągu jednego dnia roboczego. Wolisz od razu porozmawiać? Zadzwoń.</p>

      <dl class="mt-8 space-y-5">
        <div>
          <dt class="text-sm font-bold uppercase tracking-wider text-muted">Telefon</dt>
          <dd><a class="text-2xl font-extrabold text-brand-700 hover:underline" href={`tel:${site.telefon}`}>{site.telefonWyswietlany}</a></dd>
        </div>
        <div>
          <dt class="text-sm font-bold uppercase tracking-wider text-muted">E-mail</dt>
          <dd><a class="font-semibold hover:underline" href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        <div>
          <dt class="text-sm font-bold uppercase tracking-wider text-muted">Adres</dt>
          <dd class="font-semibold">{adresPelny}</dd>
          <dd><a class="mt-1 inline-block font-semibold text-brand-600 underline underline-offset-2" href={nawiguj} rel="noopener">Nawiguj w Mapach Google →</a></dd>
        </div>
        <div>
          <dt class="text-sm font-bold uppercase tracking-wider text-muted">Godziny</dt>
          {site.godziny.map((g) => <dd class="font-semibold">{g.etykieta}: {g.od}–{g.do}</dd>)}
        </div>
        <div>
          <dt class="text-sm font-bold uppercase tracking-wider text-muted">Obszar działania</dt>
          <dd class="font-semibold">{site.obszarDzialania.join(" · ")}</dd>
        </div>
      </dl>
    </div>

    <form
      id="formularz"
      class="rounded-3xl border border-ink/8 bg-white p-6 shadow-sm sm:p-8"
      method="POST"
      action={endpoint || undefined}
      data-demo={endpoint ? undefined : "true"}
    >
      <div class="grid gap-5">
        <div>
          <label for="imie" class="mb-1.5 block font-semibold">Imię</label>
          <input id="imie" name="imie" required autocomplete="given-name" class="w-full rounded-xl border border-ink/20 bg-paper px-4 py-3 focus:border-brand-500" />
        </div>
        <div>
          <label for="tel" class="mb-1.5 block font-semibold">Telefon</label>
          <input id="tel" name="telefon" type="tel" required autocomplete="tel" inputmode="tel" class="w-full rounded-xl border border-ink/20 bg-paper px-4 py-3 focus:border-brand-500" />
        </div>
        <div>
          <label for="miejscowosc" class="mb-1.5 block font-semibold">Miejscowość</label>
          <input id="miejscowosc" name="miejscowosc" autocomplete="address-level2" class="w-full rounded-xl border border-ink/20 bg-paper px-4 py-3 focus:border-brand-500" />
        </div>
        <div>
          <label for="wiadomosc" class="mb-1.5 block font-semibold">Krótko o budynku <span class="font-normal text-muted">(opcjonalnie)</span></label>
          <textarea id="wiadomosc" name="wiadomosc" rows="4" class="w-full rounded-xl border border-ink/20 bg-paper px-4 py-3 focus:border-brand-500" placeholder="np. dom 140 m², rok 1998, obecnie kocioł na ekogroszek"></textarea>
        </div>
        <!-- honeypot antyspamowy -->
        <div class="hidden" aria-hidden="true">
          <label for="firma_www">Nie wypełniaj</label>
          <input id="firma_www" name="_gotcha" tabindex="-1" autocomplete="off" />
        </div>
        <label class="flex items-start gap-3 text-sm text-muted">
          <input type="checkbox" required class="mt-1 h-5 w-5 shrink-0 accent-brand-600" />
          <span>Zapoznałem(-am) się z <a class="underline" href="/polityka-prywatnosci/">polityką prywatności</a> i zgadzam się na kontakt w sprawie zapytania.</span>
        </label>
        <button type="submit" class="btn-primary w-full text-lg">Wyślij zapytanie</button>
        <p id="formularz-status" class="text-center text-sm font-semibold text-brand-700" role="status" aria-live="polite"></p>
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("#formularz");
  const status = document.querySelector<HTMLParagraphElement>("#formularz-status");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!status) return;
    if (form.dataset.demo) {
      status.textContent = "Wersja demonstracyjna — formularz nie wysyła danych. Na stronie klienta trafia do jego skrzynki.";
      return;
    }
    status.textContent = "Wysyłanie…";
    try {
      const res = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
      if (!res.ok) throw new Error();
      form.reset();
      status.textContent = "Dziękujemy! Oddzwonimy w ciągu jednego dnia roboczego.";
    } catch {
      status.textContent = "Nie udało się wysłać. Zadzwoń do nas bezpośrednio.";
    }
  });
</script>
