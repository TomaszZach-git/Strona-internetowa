---
import { faq } from "../config/faq";
---

<section id="faq" class="scroll-mt-20 bg-white py-20 md:py-28">
  <div class="container-x max-w-3xl">
    <p class="eyebrow text-center">Pytania</p>
    <h2 class="h2 mt-2 text-center">Najczęściej zadawane pytania</h2>
    <div class="mt-10 divide-y divide-ink/10 border-y border-ink/10">
      {faq.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-bold marker:hidden">
            {f.q}
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-700 transition group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
