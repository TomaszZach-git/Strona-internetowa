---
import { site } from "../config/site.config";
---

<section class="relative overflow-hidden bg-brand-900 text-white">
  <div class="pointer-events-none absolute -right-40 -top-40 h-[34rem] w-[34rem] rounded-full bg-brand-500/30 blur-3xl" aria-hidden="true"></div>
  <div class="container-x relative grid items-center gap-10 py-16 md:grid-cols-[1.15fr_1fr] md:py-24">
    <div>
      <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-semibold text-brand-100">
        <span class="h-2 w-2 rounded-full bg-accent-400" aria-hidden="true"></span>
        {site.adres.miasto} i okolice do 60 km
      </p>
      <h1 class="text-4xl font-extrabold leading-[1.1] tracking-tight text-balance sm:text-5xl lg:text-6xl">
        Pompa ciepła dobrana do Twojego domu, nie do katalogu
      </h1>
      <p class="mt-6 max-w-xl text-lg text-brand-100">
        Liczymy zapotrzebowanie budynku na ciepło, montujemy w jeden–dwa dni i pomagamy
        w formalnościach dotacyjnych. Bezpłatna wizja lokalna w ciągu tygodnia.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#kontakt" class="btn-primary text-lg">Umów bezpłatną wizję</a>
        <a href={`tel:${site.telefon}`} class="btn-ghost text-lg">{site.telefonWyswietlany}</a>
      </div>
      <ul class="mt-10 grid max-w-xl grid-cols-1 gap-3 text-[15px] text-brand-100 sm:grid-cols-3">
        {["Gwarancja na montaż", "Serwis pogwarancyjny", "Pomoc z dotacją"].map((t) => (
          <li class="flex items-center gap-2">
            <svg class="h-5 w-5 shrink-0 text-accent-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"/></svg>
            {t}
          </li>
        ))}
      </ul>
    </div>

    <!-- Ilustracja: dom z jednostką zewnętrzną pompy ciepła -->
    <div class="relative mx-auto w-full max-w-[15rem] sm:max-w-sm md:max-w-md" aria-hidden="true">
      <svg viewBox="0 0 400 340" class="h-auto w-full drop-shadow-2xl">
        <circle cx="320" cy="70" r="34" fill="#f5a524" opacity=".9" />
        <rect x="0" y="300" width="400" height="40" rx="6" fill="#17704a" />
        <path d="M60 160 190 60l130 100" fill="none" stroke="#d5ece1" stroke-width="14" stroke-linejoin="round" />
        <rect x="80" y="150" width="220" height="150" fill="#fbfaf6" />
        <rect x="110" y="185" width="56" height="50" rx="4" fill="#d5ece1" />
        <rect x="214" y="185" width="56" height="50" rx="4" fill="#d5ece1" />
        <rect x="170" y="240" width="40" height="60" rx="3" fill="#115a3b" />
        <!-- jednostka zewnętrzna -->
        <g transform="translate(300 222)">
          <rect width="90" height="78" rx="8" fill="#ffffff" stroke="#c7d6ce" stroke-width="2" />
          <circle cx="45" cy="36" r="24" fill="none" stroke="#1f8a5b" stroke-width="4" />
          <g stroke="#1f8a5b" stroke-width="3" stroke-linecap="round">
            <path d="M45 36 45 16" /><path d="M45 36 62 46" /><path d="M45 36 28 46" />
          </g>
          <rect x="10" y="66" width="70" height="4" rx="2" fill="#c7d6ce" />
        </g>
        <!-- fale ciepła -->
        <g fill="none" stroke="#f5a524" stroke-width="4" stroke-linecap="round" opacity=".85">
          <path d="M150 140c-8-10 8-18 0-28" /><path d="M190 132c-8-10 8-18 0-28" /><path d="M230 140c-8-10 8-18 0-28" />
        </g>
      </svg>
    </div>
  </div>
</section>
